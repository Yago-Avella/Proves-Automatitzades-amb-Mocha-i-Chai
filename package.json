{
  "name": "appsalud",
  "version": "1.0.0",
  "description": "Pràctica de proves automatitzades amb Mocha i Chai",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "mocha \"test/**/*.spec.js\"",
    "test:unitaries": "mocha \"test/unitaries/*.spec.js\"",
    "test:integracio": "mocha \"test/integracio/*.spec.js\"",
    "test:informe": "mocha \"test/**/*.spec.js\" --reporter mochawesome",
    "test:cobertura": "c8 --reporter=text --reporter=html mocha \"test/**/*.spec.js\""
  },
  "keywords": [
    "javascript",
    "mocha",
    "chai",
    "proves",
    "appSalud"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1",
    "sinon": "^22.1.0"
  },
  "directories": {
    "test": "test"
  }
}
